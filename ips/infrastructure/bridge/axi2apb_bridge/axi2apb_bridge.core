CAPI=2:
name: aixsilicon:ip:axi2apb_bridge:1.0.0
description: "axi2apb_bridge (X2P) AXI-to-APB Bridge (AXI4/AXI4-Lite -> APB3/APB4, Full Feature)"

filesets:
  rtl_handwritten:
    files:
      - rtl/x2p_pkg.sv
      - rtl/x2p_req_mgr.sv
      - rtl/x2p_scheduler.sv
      - rtl/x2p_transfer_engine.sv
      - rtl/x2p_cdc.sv
      - rtl/x2p_apb_engine.sv
      - rtl/x2p_rsp_mgr.sv
      - rtl/x2p_axi_frontend.sv
      - rtl/x2p_top.sv
    file_type: systemVerilogSource

  rtl_includes:
    files:
      - rtl/include/x2p_defs.svh
    file_type: systemVerilogSource

targets:
  lint:
    default_tool: vcs
    filesets:
      - rtl_handwritten
      - rtl_includes
    toplevel: x2p_top
    tools:
      vcs:
        mode: lint
        flags:
          - -sverilog
          - -full64
          - -notice
          - -lint=all
          - -q

  elab:
    default_tool: vcs
    filesets:
      - rtl_handwritten
      - rtl_includes
    toplevel: x2p_top
    tools:
      vcs:
        mode: elab
        flags:
          - -sverilog
          - -full64
          - -notice
          - -q

  sim:
    default_tool: vcs
    filesets:
      - rtl_handwritten
      - rtl_includes
    tools:
      vcs:
        mode: sim
        flags:
          - -sverilog
          - -full64
          - -notice
          - -ntb_opts uvm-1.2
          - -debug_access+all
          - -kdb
          - +vpi
          - -l sim.log
        top_module: tb_top

  smoke:
    default_tool: vcs
    filesets:
      - rtl_handwritten
      - rtl_includes
    tools:
      vcs:
        mode: sim
        flags:
          - -sverilog
          - -full64
          - -notice
          - -ntb_opts uvm-1.2
          - -debug_access+all
          - -kdb
          - +vpi
          - -l smoke.log
        top_module: tb_top

  synth:
    default_tool: dc
    filesets:
      - rtl_handwritten
      - rtl_includes
    toplevel: x2p_top
    tools:
      dc:
        script: |

  formal:
    default_tool: vc_formal
    filesets:
      - rtl_handwritten
      - rtl_includes
    tools:
      vc_formal:
        task: prove
        depth: 10
        flags:
          - -sverilog