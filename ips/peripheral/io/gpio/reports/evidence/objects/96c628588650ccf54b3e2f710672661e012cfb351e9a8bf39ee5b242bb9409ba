95                 previous_q[i]<=value_q[i]; baseline_q[i]<=valid_q[i] && enable_q[i] && available_i[i];
96                 if (commit && bank==i/32) begin
                   <font color = "green">-2-</font>  
97                   enable_q[i]<=new_enable[i%32]; mode_q[i]<={new_mode2[i%32],new_mode1[i%32],new_mode0[i%32]};
           <font color = "green">          ==></font>
98                 end
                   MISSING_ELSE
           <font color = "green">        ==></font>
99                 if (!INPUT_CAP_MASK[i] || !available_i[i] || (commit && bank==i/32)) begin
                   <font color = "green">-3-</font>  
100                  fill_q[i]<='0; count_q[i]<='0; candidate_q[i]<=1'b0;
           <font color = "green">          ==></font>
101                  value_q[i]<=1'b0; valid_q[i]<=1'b0; previous_q[i]<=1'b0; baseline_q[i]<=1'b0;
102                end else if (fill_q[i]<2'd2) fill_q[i]<=fill_q[i]+2'd1;
                            <font color = "green">-4-</font>  
           <font color = "green">        ==></font>
103                else if (div_counter_q[i/32]==divider_q[i/32]) begin
                        <font color = "red">-5-</font>  
104                  count_q[i]<=next_count; candidate_q[i]<=sync_q[1][i];
105                  if (next_count>={1'b0,count_cfg_q[i/32]}+9'd1) begin value_q[i]<=sync_q[1][i]; valid_q[i]<=1'b1; end
                     <font color = "red">-6-</font>  
           <font color = "green">          ==></font>
                     MISSING_ELSE
           <font color = "red">          ==></font>
106                end
                   MISSING_ELSE
           <font color = "red">        ==></font>
