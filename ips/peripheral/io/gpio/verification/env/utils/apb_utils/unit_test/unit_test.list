// 包含路径
+incdir+../src
+incdir+./

// 接口定义 (单独编译，不放入 package)
../src/apb_interface.sv

// 包文件 (包含所有 UVM 类)
../src/apb_package.sv

// 单元测试组件
./unit_test_checker.sv
./unit_test_env.sv

// 测试用例
./tc_base.sv
./tc_sanity.sv

// 顶层模块
./harness.sv
