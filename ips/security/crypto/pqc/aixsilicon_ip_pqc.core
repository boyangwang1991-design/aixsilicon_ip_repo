CAPI=2:
name: aixsilicon:ip:pqc:0.1.0
description: PQC candidate RTL and self-checking module unit tests
filesets:
  common:
    files:
    - rtl/pqc_pkg.sv
    file_type: systemVerilogSource
  generated:
    files:
    - rtl/generated/pqc_csr_pkg.sv
    - rtl/generated/pqc_csr.sv
    file_type: systemVerilogSource
  rtl:
    files:
    - rtl/include/pqc_ntt_rom.svh:
        is_include_file: true
    - rtl/include/pqc_secded_functions.svh:
        is_include_file: true
    - rtl/pqc_masked_and.sv
    - rtl/pqc_keccak_masked_round.sv
    - rtl/pqc_axi_read_arb.sv
    - rtl/pqc_keccak.sv
