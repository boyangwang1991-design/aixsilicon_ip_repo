    - rtl/pqc_dma.sv
    - rtl/pqc_desc_fetch.sv
    - rtl/pqc_desc_validate.sv
    - rtl/pqc_fault_ctrl.sv
    - rtl/pqc_kem_seq.sv
    - rtl/pqc_dsa_seq.sv
    - rtl/pqc_cmd_frontend.sv
    - rtl/pqc_apb_if.sv
    - rtl/pqc_top.sv
    - rtl/pqc_random_service.sv
    file_type: systemVerilogSource
  ut:
    files:
    - verification/unit_test/golden/pqc_golden_vectors.svh:
        is_include_file: true
    - verification/unit_test/ut_pqc_apb_if.sv
    - verification/unit_test/ut_pqc_axi_read_arb.sv
    - verification/unit_test/ut_pqc_clear_boundaries.sv
    - verification/unit_test/ut_pqc_cmd_frontend.sv
    - verification/unit_test/ut_pqc_ecc_sram.sv
    - verification/unit_test/ut_pqc_codec.sv
    - verification/unit_test/ut_pqc_codec_math.sv
    - verification/unit_test/ut_pqc_codec_sram.sv
    - verification/unit_test/ut_pqc_csr.sv
    - verification/unit_test/ut_pqc_desc_fetch.sv
    - verification/unit_test/ut_pqc_desc_validate.sv
    - verification/unit_test/ut_pqc_dma.sv
    - verification/unit_test/ut_pqc_dma_cancel.sv
    - verification/unit_test/ut_pqc_dma_overflow.sv
    - verification/unit_test/ut_pqc_dma_sram.sv
    - verification/unit_test/ut_pqc_dsa_replay.sv
    - verification/unit_test/ut_pqc_dsa_seq.sv
    - verification/unit_test/ut_pqc_engine_cancel.sv
    - verification/unit_test/ut_pqc_fault_ctrl.sv
    - verification/unit_test/ut_pqc_frontend_crc.sv
    - verification/unit_test/ut_pqc_keccak.sv
    - verification/unit_test/ut_pqc_keccak_boundaries.sv
    - verification/unit_test/ut_pqc_keccak_masked_round.sv
    - verification/unit_test/ut_pqc_kem_select.sv
    - verification/unit_test/ut_pqc_kem_seq.sv
    - verification/unit_test/ut_pqc_key_slots.sv
    - verification/unit_test/ut_pqc_masked_and.sv
    - verification/unit_test/ut_pqc_masked_random_path.sv
    - verification/unit_test/ut_pqc_pkg.sv
    - verification/unit_test/ut_pqc_poly_engine.sv
    - verification/unit_test/ut_pqc_random_service.sv
    - verification/unit_test/ut_pqc_sampler.sv
    - verification/unit_test/ut_pqc_sampler_config.sv
    - verification/unit_test/ut_pqc_sampler_dsa.sv
    - verification/unit_test/ut_pqc_secure_sram_ctrl.sv
    - verification/unit_test/ut_pqc_seq_dispatch.sv
    - verification/unit_test/ut_pqc_sram_byte_access.sv
    - verification/unit_test/ut_pqc_top.sv
    - verification/unit_test/ut_pqc_top_review.sv
    - verification/unit_test/ut_pqc_work_key_ram.sv
    file_type: systemVerilogSource
  # Protocol VIP dependencies. Declared as their own fileset and listed BEFORE
  # uvm_env in the `uvm` target so the VIP packages (apb_pkg / axi4_pkg) are
  # compiled before the PQC environment that imports them.
  #
  # The VIP source is NOT copied into this repository; FuseSoC/edalize resolve
  # and export it from aixsilicon_vip_repo (docs/reuse_plan.md §1.4/§4.2).
  # NOTE on the protocol VIPs: the APB / AXI4 agents are NOT defined in this IP.
  # They come from aixsilicon_vip_repo and are consumed read-only. Two facts
  # prevent wiring them through FuseSoC `depend:` here:
  #   1. the published VIP cores do not declare their own src include path (their
  #      packages include e.g. "apb_config.sv"), and apb_config.sv is not even
  #      listed in the APB VIP core's fileset;
  #   2. edalize computes dependency file paths relative to the core root while
  #      VCS runs in the build directory, so an in-place relative reference is
  #      not stable.
  # The VIPs are therefore referenced through the local-first entry point
  # allowed by reuse-plan §4.2.3: verification/verification.list +
  # verification/sim/Makefile with VIP_ROOT pointing at the VIP repo. No VIP
  # source is copied into this repository. The VIP-core defects above are
  # recorded for vip-development-suite.

  # PQC-side verification environment. Protocol agents are NOT defined here.
  uvm_env:
    files:
    - verification/ral/pqc_ral_pkg.sv
    - verification/env/pqc_env_dec.sv
    - verification/env/pqc_dut_cfg.sv
    - verification/env/pqc_rm_cfg.sv
    - verification/env/pqc_checker_cfg.sv
    - verification/env/pqc_fcov.sv
    - verification/env/pqc_rm.sv
    - verification/env/pqc_checker.sv
    - verification/env/pqc_virtual_sequencer.sv
    - verification/env/pqc_virtual_sequence.sv
    - verification/env/pqc_env_cfg.sv
    - verification/env/pqc_apb_adapter.sv
    - verification/env/pqc_env.sv
    - verification/tc/tc_define.sv
    - verification/tc/tc_base.sv
    - verification/tc/tc_cmd_smoke.sv
    - verification/tc/tc_apb_protection.sv
    - verification/tc/tc_reg_reset_attr.sv
    - verification/th/harness.sv
    file_type: systemVerilogSource
  vectors:
    files:
    - verification/unit_test/golden/review_fix/descriptor_zlib.hex
    - verification/unit_test/golden/review_fix/hash_0_0.hex
    - verification/unit_test/golden/review_fix/hash_0_135.hex
    - verification/unit_test/golden/review_fix/hash_0_136.hex
    - verification/unit_test/golden/review_fix/hash_0_137.hex
    - verification/unit_test/golden/review_fix/hash_0_272.hex
    - verification/unit_test/golden/review_fix/hash_0_289.hex
    - verification/unit_test/golden/review_fix/hash_1_0.hex
    - verification/unit_test/golden/review_fix/hash_1_144.hex
    - verification/unit_test/golden/review_fix/hash_1_161.hex
    - verification/unit_test/golden/review_fix/hash_1_71.hex
    - verification/unit_test/golden/review_fix/hash_1_72.hex
    - verification/unit_test/golden/review_fix/hash_1_73.hex
    - verification/unit_test/golden/review_fix/hash_2_0.hex
    - verification/unit_test/golden/review_fix/hash_2_167.hex
    - verification/unit_test/golden/review_fix/hash_2_168.hex
    - verification/unit_test/golden/review_fix/hash_2_169.hex
    - verification/unit_test/golden/review_fix/hash_2_336.hex
    - verification/unit_test/golden/review_fix/hash_2_353.hex
    - verification/unit_test/golden/review_fix/hash_3_0.hex
    - verification/unit_test/golden/review_fix/hash_3_135.hex
    - verification/unit_test/golden/review_fix/hash_3_136.hex
    - verification/unit_test/golden/review_fix/hash_3_137.hex
    - verification/unit_test/golden/review_fix/hash_3_272.hex
    - verification/unit_test/golden/review_fix/hash_3_289.hex
    - verification/unit_test/golden/review_fix/sampler_0.hex
    - verification/unit_test/golden/review_fix/sampler_1.hex
    - verification/unit_test/golden/review_fix/sampler_2.hex
    - verification/unit_test/golden/review_fix/sampler_3.hex
    - verification/unit_test/golden/review_fix/sampler_4.hex
    - verification/unit_test/golden/review_fix/sampler_5.hex
    - verification/unit_test/golden/review_fix/sampler_6.hex
    - verification/unit_test/golden/review_fix/sampler_7.hex
    - verification/unit_test/golden/review_fix/sampler_stream.hex
    file_type: user
  lint_waivers:
    files:
    - constraints/lint_waivers.tcl
    file_type: waiver
  synth_constraints:
    files:
    - constraints/pqc_characterization.sdc
    file_type: SDC
targets:
  default:
    filesets:
    - common
    - generated
    - rtl
    toplevel: pqc_top
  elab:
    default_tool: vcs
    filesets:
    - common
    - generated
    - rtl
    toplevel: pqc_top
    tools:
      vcs:
        vcs_options:
        - -sverilog
        - -timescale=1ns/1ps
        - -ntb_opts
        - uvm-1.2
        - -notice
        - +vcs+flush+all
        - -l
        - compile.log
  lint:
    default_tool: spyglass
    filesets:
    - common
    - generated
    - rtl
    - lint_waivers
    toplevel: pqc_top
    tools:
      spyglass:
        goals:
        - lint/lint_rtl
        spyglass_options:
        - enableSV yes
        # The parameterized working memory is a register array at RTL and keeps
        # that structure until the hardening macro swap (pqc_ecc_sram is the
        # intended macro boundary). handlememory makes SpyGlass analyse it as an
        # addressed memory (module annotation SYNTH_5014 "Memory analysis
        # enabled") instead of exploding 16K words into flops, which exhausts
        # machine memory.
        #
        - handlememory yes
        rule_parameters:
        # W123 reports that the wide memory signals of pqc_ecc_sram (39-bit code
        # word x 16K entries) and pqc_work_key_ram are "size too big thus not
        # processed"; this is the remedy that message names, and it is required
        # for the memory bodies to be rule-checked at all. It needs the large
        # elaboration memory budget available on the signoff host.
        - handle_large_bus yes
  synth:
    default_tool: design_compiler
    filesets:
    - common
    - generated
    - rtl
    toplevel: pqc_top
    tools:
      design_compiler:
        script_dir: $::env(IP_ROOT)/scripts/ppa
        dc_script: synth.tcl
        report_dir: reports
  ut_pqc_apb_if:
    default_tool: vcs
    filesets:
    - common
    - generated
    - rtl
    - ut
    - vectors
    toplevel: ut_pqc_apb_if
    tools:
      vcs:
        vcs_options:
        - -sverilog
        - -timescale=1ns/1ps
        - -ntb_opts
        - uvm-1.2
        - -notice
        - +vcs+flush+all
        run_options:
        - +VECTORS=src/aixsilicon_ip_pqc_0.1.0/verification/unit_test/golden/review_fix
  ut_pqc_axi_read_arb:
    default_tool: vcs
    filesets:
    - common
    - generated
    - rtl
    - ut
    - vectors
    toplevel: ut_pqc_axi_read_arb
    tools:
      vcs:
        vcs_options:
        - -sverilog
        - -timescale=1ns/1ps
        - -ntb_opts
        - uvm-1.2
        - -notice
        - +vcs+flush+all
        run_options:
        - +VECTORS=src/aixsilicon_ip_pqc_0.1.0/verification/unit_test/golden/review_fix
  ut_pqc_clear_boundaries:
    default_tool: vcs
    filesets:
    - common
    - generated
    - rtl
    - ut
    - vectors
    toplevel: ut_pqc_clear_boundaries
    tools:
      vcs:
        vcs_options:
        - -sverilog
        - -timescale=1ns/1ps
        - -ntb_opts
        - uvm-1.2
        - -notice
        - +vcs+flush+all
        run_options:
        - +VECTORS=src/aixsilicon_ip_pqc_0.1.0/verification/unit_test/golden/review_fix
  # Reference target (not the primary entry): it compiles the PQC-side UVM
  # environment only. The protocol VIPs are added by verification.list /
  # verification/sim/Makefile, which is the entry used for regression
  # (see the note in the vip_apb area).
  uvm:
    default_tool: vcs
    filesets:
    - common
    - generated
    - rtl
    - uvm_env
    toplevel: harness
    tools:
      vcs:
        vcs_options:
        - -sverilog
        - -timescale=1ns/1ps
        - -ntb_opts
        - uvm-1.2
        # The VIP packages include uvm_macros.svh and their own sources with
        # paths relative to their src root, but the published VIP FuseSoC cores
        # declare neither the UVM nor their own src include path. Supply both
        # here as consumer-side compile options (allowed readonly reference per
        # reuse-plan §4.2.3); the VIP sources themselves are not modified.
        #
        # The VIP files are referenced in place (see the vip_apb / vip_axi4
        # filesets above), so the include path uses the same traversal prefix,
        # anchored like the source paths on the exported core root.
        - +incdir+$VCS_HOME/etc/uvm-1.2
        - +incdir+src/aixsilicon_ip_pqc_0.1.0/../../../../../aixsilicon_vip_repo/vip/amba/apb/src
        - +incdir+src/aixsilicon_ip_pqc_0.1.0/../../../../../aixsilicon_vip_repo/vip/amba/axi4/src
        - -notice
        - +vcs+flush+all
        - -l
        - compile.log
  ut_pqc_ecc_sram:
    default_tool: vcs
    filesets:
    - common
    - generated
    - rtl
    - ut
    - vectors
    toplevel: ut_pqc_ecc_sram
    tools:
      vcs:
        vcs_options:
        - -sverilog
        - -timescale=1ns/1ps
        - -ntb_opts
        - uvm-1.2
        - -notice
        - +vcs+flush+all
  ut_pqc_cmd_frontend:
    default_tool: vcs
    filesets:
    - common
    - generated
    - rtl
    - ut
    - vectors
    toplevel: ut_pqc_cmd_frontend
