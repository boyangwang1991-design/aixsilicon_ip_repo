/// @class apb_base_sequence
/// @brief Base class for all XX protocol sequences
///        Extends uvm_sequence with apb_xaction transaction type
/// NOTE: Replace 'uvm_sequence #(apb_xaction)' with your base sequence type if needed
class apb_base_sequence extends uvm_sequence #(apb_xaction);

  `uvm_object_utils(apb_base_sequence)

  /// @brief Constructor
  /// @param name Sequence name string
  extern function new(string name = "apb_base_sequence");

  // ---------------------------------------------------------------------------
  // UVM Sequence Hooks
  // ---------------------------------------------------------------------------

  /// @brief Pre-body hook, called before body() execution
  ///        Can be used for pre-condition setup, raising objections, etc.
  extern virtual task pre_body();

  /// @brief Post-body hook, called after body() execution
  ///        Can be used for cleanup, dropping objections, etc.
  extern virtual task post_body();

endclass

// =============================================================================
// Extern function definitions
// =============================================================================

/// @brief Constructor definition
/// @param name Sequence name string
function apb_base_sequence::new(string name = "apb_base_sequence");
  super.new(name);
endfunction

// ---------------------------------------------------------------------------
// UVM Sequence Hook definitions
// ---------------------------------------------------------------------------

/// @brief Pre-body hook definition
///        Add pre-body logic here (e.g., raise objection, pre-condition setup)
task apb_base_sequence::pre_body();
  super.pre_body();
  // TODO: Add pre-body logic here
endtask

/// @brief Post-body hook definition
///        Add post-body logic here (e.g., drop objection, post-condition check)
task apb_base_sequence::post_body();
  super.post_body();
  // TODO: Add post-body logic here
endtask


/// @class apb_default_sequence
/// @brief Default sequence for XX protocol
///        Performs a basic write-read transaction sequence
class apb_default_sequence extends apb_base_sequence;

  `uvm_object_utils(apb_default_sequence)

  /// @brief Constructor
  /// @param name Sequence name string
  extern function new(string name = "apb_default_sequence");

  /// @brief Sequence body - execute sanity test transactions
  extern virtual task body();

endclass

// =============================================================================
// Extern function definitions
// =============================================================================

/// @brief Constructor definition
/// @param name Sequence name string
function apb_default_sequence::new(string name = "apb_default_sequence");
  super.new(name);
endfunction

/// @brief Sequence body definition
task apb_default_sequence::body();
  apb_xaction tr;

  `uvm_info(get_type_name(), "Start apb_default_sequence", UVM_MEDIUM)

  // Write transaction: write data 0x12345678 to address 0x0
  tr = apb_xaction::type_id::create("tr");
  start_item(tr);
  assert(tr.randomize() with {
    cmd  == APB_WRITE;
    addr == 'h0;
    data == 'h1234_5678;
    strb == '1;
  });
  finish_item(tr);

  // Read transaction: read back from address 0x0
  tr = apb_xaction::type_id::create("tr");
  start_item(tr);
  assert(tr.randomize() with {
    cmd  == APB_READ;
    addr == 'h0;
  });
  finish_item(tr);

  `uvm_info(get_type_name(), "End apb_default_sequence", UVM_MEDIUM)
endtask

`endif
