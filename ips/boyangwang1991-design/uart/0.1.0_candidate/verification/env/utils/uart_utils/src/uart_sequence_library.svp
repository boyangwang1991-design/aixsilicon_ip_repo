`ifndef UART_SEQUENCE_LIBRARY_SVP
`define UART_SEQUENCE_LIBRARY_SVP

/// @class uart_base_sequence
/// @brief Base class for all XX protocol sequences
///        Extends uvm_sequence with uart_xaction transaction type
/// NOTE: Replace 'uvm_sequence #(uart_xaction)' with your base sequence type if needed
class uart_base_sequence extends uvm_sequence #(uart_xaction);

  `uvm_object_utils(uart_base_sequence)

  /// @brief Constructor
  /// @param name Sequence name string
  extern function new(string name = "uart_base_sequence");

  // ---------------------------------------------------------------------------
  // UVM Sequence Hooks
  // ---------------------------------------------------------------------------

  /// @brief Pre-body hook, called before body() execution
  ///        Can be used for pre-condition setup, raising objections, etc.
  extern virtual task pre_body();

  /// @brief Post-body hook, called after body() execution
  ///        Can be used for cleanup, dropping objections, etc.
  extern virtual task post_body();

endclass

// =============================================================================
// Extern function definitions
// =============================================================================

/// @brief Constructor definition
/// @param name Sequence name string
function uart_base_sequence::new(string name = "uart_base_sequence");
  super.new(name);
endfunction

// ---------------------------------------------------------------------------
// UVM Sequence Hook definitions
// ---------------------------------------------------------------------------

/// @brief Pre-body hook definition
///        Add pre-body logic here (e.g., raise objection, pre-condition setup)
task uart_base_sequence::pre_body();
  super.pre_body();
  // TODO: Add pre-body logic here
endtask

/// @brief Post-body hook definition
///        Add post-body logic here (e.g., drop objection, post-condition check)
task uart_base_sequence::post_body();
  super.post_body();
  // TODO: Add post-body logic here
endtask


/// @class uart_default_sequence
/// @brief Default sequence for XX protocol
///        Performs a basic write-read transaction sequence
class uart_default_sequence extends uart_base_sequence;

  `uvm_object_utils(uart_default_sequence)

  /// @brief Constructor
  /// @param name Sequence name string
  extern function new(string name = "uart_default_sequence");

  /// @brief Sequence body - execute sanity test transactions
  extern virtual task body();

endclass

// =============================================================================
// Extern function definitions
// =============================================================================

/// @brief Constructor definition
/// @param name Sequence name string
function uart_default_sequence::new(string name = "uart_default_sequence");
  super.new(name);
endfunction

/// @brief Sequence body definition
task uart_default_sequence::body();
  uart_xaction tr;

  `uvm_info(get_type_name(), "Start uart_default_sequence", UVM_MEDIUM)

  // Transmit a data byte (8-bit, no parity, normal mode)
  tr = uart_xaction::type_id::create("tr");
  start_item(tr);
  assert(tr.randomize() with {
    data      == 'h55;
    parity_en == 1'b0;
    err_type  == UART_ERR_NONE;
    mode      == UART_MODE_NORMAL;
  });
  finish_item(tr);

  // Transmit a second byte (data 0xAA)
  tr = uart_xaction::type_id::create("tr");
  start_item(tr);
  assert(tr.randomize() with {
    data      == 'hAA;
    parity_en == 1'b0;
    err_type  == UART_ERR_NONE;
    mode      == UART_MODE_NORMAL;
  });
  finish_item(tr);

  `uvm_info(get_type_name(), "End uart_default_sequence", UVM_MEDIUM)
endtask

`endif
