CAPI=2:
name: "boyangwang1991-design:ip:uart:0.1.0"
description: "UART full duplex serial communication interface (OpenTitan core, unchanged; APB + TL-UL dual bus access)"

filesets:
  # Unified-repo common library dependencies (resolved via FuseSoC)
  files_common_libs:
    depend:
      - lowrisc:prim:all
      - lowrisc:ip:tlul
      - lowrisc:top:constants

  # Handwritten UART RTL (OpenTitan original core, unchanged)
  rtl_handwritten:
    files:
      - ../rtl/uart_reg_pkg.sv
      - ../rtl/uart_reg_top.sv
      - ../rtl/uart_rx.sv
      - ../rtl/uart_tx.sv
      - ../rtl/uart_core.sv
      - ../rtl/uart.sv
    file_type: systemVerilogSource

  # Generated CSR RTL (PeakRDL APB-flat, for APB target)
  rtl_generated:
    files:
      - ../rtl/generated/uart_csr_pkg.sv
      - ../rtl/generated/uart_csr.sv
    file_type: systemVerilogSource

  # New APB2TLUL wrapper (APB access path, does not modify core)
  rtl_apb_wrapper:
    files:
      - ../rtl/apb2tlul.sv
      - ../rtl/uart_apb_top.sv
    file_type: systemVerilogSource

  rtl_includes:
    files:
      - ../rtl/include/*.svh
    file_type: systemVerilogSource

  verif_harness:
    files:
      - ../verification/th/harness.sv
    file_type: systemVerilogSource

  verif_uvm:
    files:
      - ../verification/env/utils/*_utils/src/*_package.sv
      - ../verification/env/*_env_package.sv
      - ../verification/tc/tc_package.sv
    file_type: systemVerilogSource

targets:
  # ---- Default TL-UL target: original UART core (TL-UL slave) ----
  default:
    filesets:
      - files_common_libs
      - rtl_handwritten
    toplevel: uart

  # ---- APB target: APB access via apb2tlul wrapper (core unchanged) ----
  apb:
    filesets:
      - files_common_libs
      - rtl_handwritten
      - rtl_apb_wrapper
      - rtl_generated
    toplevel: uart_apb_top

  # Lint target (VCS)
  lint:
    default_tool: vcs
    filesets:
      - files_common_libs
      - rtl_handwritten
      - rtl_generated
      - rtl_apb_wrapper
    tools:
      vcs:
        mode: lint
        flags:
          - -sverilog
          - -full64
          - -notice
          - -ntb_opts uvm-1.2
          - -q

  # Elaboration target (VCS)
  elab:
    default_tool: vcs
    filesets:
      - files_common_libs
      - rtl_handwritten
      - rtl_generated
      - rtl_apb_wrapper
    tools:
      vcs:
        mode: elab
        flags:
          - -sverilog
          - -full64
          - -notice
          - -ntb_opts uvm-1.2
          - -q
        toplevel: uart

  # Simulation target (VCS + UVM 1.2); full regression via verification/sim/Makefile
  sim:
    default_tool: vcs
    filesets:
      - files_common_libs
      - rtl_handwritten
      - rtl_generated
      - rtl_apb_wrapper
      - verif_harness
      - verif_uvm
    tools:
      vcs:
        mode: sim
        flags:
          - -sverilog
          - -full64
          - -notice
          - -ntb_opts uvm-1.2
          - -debug_access+all
          - -kdb
          - +vpi
          - -l sim.log
        toplevel: harness

  # Smoke target (VCS + UVM 1.2)
  smoke:
    default_tool: vcs
    filesets:
      - files_common_libs
      - rtl_handwritten
      - rtl_generated
      - rtl_apb_wrapper
      - verif_harness
      - verif_uvm
    tools:
      vcs:
        mode: sim
        flags:
          - -sverilog
          - -full64
          - -notice
          - -ntb_opts uvm-1.2
          - -debug_access+all
          - -kdb
          - +vpi
          - -l smoke.log
        toplevel: harness

  # Synthesis target (DC)
  synth:
    default_tool: dc
    filesets:
      - files_common_libs
      - rtl_handwritten
      - rtl_generated
      - rtl_apb_wrapper
    tools:
      dc:
        script: |
          analyze -format sverilog <filelist>;
          elaborate uart;
          check_design;
          report_area;

  # Formal target (VC Formal)
  formal:
    default_tool: vc_formal
    filesets:
      - files_common_libs
      - rtl_handwritten
      - rtl_generated
      - rtl_apb_wrapper
    tools:
      vc_formal:
        task: prove
        depth: 10
        flags:
          - -sverilog
